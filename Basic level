<!DOCTYPE html>
<html>
<head>
    <title>Registration Form</title>
    <style>
        body{
            font-family: Arial;
            background:#f2f2f2;
        }

        .form{
            width:300px;
            margin:auto;
            background:white;
            padding:20px;
            border:1px solid gray;
        }

        input, select{
            width:100%;
            margin:8px 0;
            padding:5px;
        }

        button{
            width:100%;
            padding:8px;
            background:green;
            color:white;
            border:none;
        }
    </style>
</head>

<body>

<div class="form">
    <h2 align="center">Registration Form</h2>

    <input type="text" placeholder="Enter Name">

    <input type="email" placeholder="Enter Email">

    <input type="password" placeholder="Enter Password">

    <select>
        <option>Select Course</option>
        <option>BCA</option>
        <option>B.Tech</option>
        <option>B.Sc</option>
    </select>

    <button>Register</button>
</div>

</body>
</html>
