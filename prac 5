<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Menu</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <!-- Food Menu -->
    <section class="max-w-6xl mx-auto px-6 py-12">

        <h1 class="text-4xl font-bold text-center text-gray-800 mb-10">
            Our Food Menu
        </h1>

        <!-- Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

            <!-- Food Card 1 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38"
                    alt="Pizza"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Cheese Pizza
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Delicious cheese pizza with fresh vegetables and herbs.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

            <!-- Food Card 2 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd"
                    alt="Burger"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Classic Burger
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Juicy grilled burger with cheese, lettuce and fresh tomato.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

            <!-- Food Card 3 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1473093295043-cdd812d0e601"
                    alt="Pasta"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Creamy Pasta
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Creamy pasta cooked with garlic, herbs and parmesan cheese.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

            <!-- Food Card 4 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1603133872878-684f208fb84b"
                    alt="Fried Rice"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Fried Rice
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Tasty fried rice prepared with fresh vegetables and spices.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

            <!-- Food Card 5 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1547592180-85f173990554"
                    alt="Salad"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Fresh Salad
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Healthy fresh salad made with vegetables and special dressing.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

            <!-- Food Card 6 -->
            <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1551024506-0bccd828d307"
                    alt="Dessert"
                    class="w-full h-48 object-cover"
                >

                <div class="p-5">
                    <h2 class="text-2xl font-bold text-gray-800">
                        Chocolate Dessert
                    </h2>

                    <p class="text-gray-600 mt-2">
                        Delicious chocolate dessert with a rich and creamy taste.
                    </p>

                    <button class="mt-4 bg-orange-500 text-white px-5 py-2 rounded-md hover:bg-orange-600">
                        Order Now
                    </button>
                </div>
            </div>

        </div>
    </section>

</body>
</html>
