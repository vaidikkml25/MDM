<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Product Showcase</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50">

    <!-- Navbar -->
    <nav class="bg-gray-900 text-white px-6 py-4">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row
                    justify-between items-center gap-3">

            <h1 class="text-2xl font-bold">
                TechStore
            </h1>

            <div class="flex gap-5">
                <a href="#" class="hover:text-blue-400">Home</a>
                <a href="#" class="hover:text-blue-400">Products</a>
                <a href="#" class="hover:text-blue-400">About</a>
            </div>
        </div>
    </nav>


    <!-- Heading -->
    <section class="text-center py-10 px-4">

        <h2 class="text-3xl md:text-4xl font-bold text-gray-800">
            Latest Products
        </h2>

        <p class="text-gray-500 mt-3">
            Discover our new collection of modern products.
        </p>

    </section>


    <!-- Product Section -->
    <section class="max-w-6xl mx-auto px-6 pb-12">

        <div class="flex flex-wrap justify-center gap-8">

            <!-- Product 1 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden
                        w-full sm:w-[45%] lg:w-[30%]">

                <img
                    src="https://images.unsplash.com/photo-1523275335684-37898b6baf30"
                    class="w-full h-52 object-cover"
                    alt="Smart Watch">

                <div class="p-5">

                    <h3 class="text-xl font-semibold">
                        Smart Watch
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Stylish smartwatch with useful smart features.
                    </p>

                    <div class="flex justify-between items-center mt-5">

                        <span class="text-lg font-bold text-blue-600">
                            ₹2,999
                        </span>

                        <button class="bg-blue-600 text-white
                                       px-4 py-2 rounded
                                       hover:bg-blue-700">
                            Buy
                        </button>

                    </div>
                </div>
            </div>


            <!-- Product 2 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden
                        w-full sm:w-[45%] lg:w-[30%]">

                <img
                    src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e"
                    class="w-full h-52 object-cover"
                    alt="Headphones">

                <div class="p-5">

                    <h3 class="text-xl font-semibold">
                        Headphones
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Wireless headphones with clear and powerful sound.
                    </p>

                    <div class="flex justify-between items-center mt-5">

                        <span class="text-lg font-bold text-blue-600">
                            ₹1,999
                        </span>

                        <button class="bg-blue-600 text-white
                                       px-4 py-2 rounded
                                       hover:bg-blue-700">
                            Buy
                        </button>

                    </div>
                </div>
            </div>


            <!-- Product 3 -->
            <div class="bg-white rounded-lg shadow-lg overflow-hidden
                        w-full sm:w-[45%] lg:w-[30%]">

                <img
                    src="https://images.unsplash.com/photo-1542291026-7eec264c27ff"
                    class="w-full h-52 object-cover"
                    alt="Shoes">

                <div class="p-5">

                    <h3 class="text-xl font-semibold">
                        Sports Shoes
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Comfortable and lightweight shoes for daily use.
                    </p>

                    <div class="flex justify-between items-center mt-5">

                        <span class="text-lg font-bold text-blue-600">
                            ₹2,499
                        </span>

                        <button class="bg-blue-600 text-white
                                       px-4 py-2 rounded
                                       hover:bg-blue-700">
                            Buy
                        </button>

                    </div>
                </div>
            </div>

        </div>
    </section>


    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center py-5">

        <p>© 2026 TechStore | All Rights Reserved</p>

    </footer>

</body>
</html>
