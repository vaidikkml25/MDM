<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technical Festival Invitation</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-r from-blue-600 to-purple-700 min-h-screen flex items-center justify-center">

    <div class="bg-white rounded-xl shadow-2xl p-8 max-w-xl text-center">

        <h1 class="text-4xl font-bold text-purple-700">
            TechFest 2026
        </h1>

        <p class="text-gray-600 mt-2 text-lg">
            Annual Technical Festival
        </p>

        <hr class="my-5">

        <h2 class="text-2xl font-semibold text-blue-600">
            You're Invited!
        </h2>

        <p class="mt-4 text-gray-700">
            Join us for exciting technical events, coding competitions,
            workshops, robotics, project exhibitions, and fun activities.
        </p>

        <div class="mt-6 text-left">
            <p><strong>📅 Date:</strong> 20 September 2026</p>
            <p><strong>🕙 Time:</strong> 10:00 AM</p>
            <p><strong>📍 Venue:</strong> College Auditorium</p>
        </div>

        <div class="mt-8">
            <button class="bg-purple-600 text-white px-6 py-3 rounded-lg hover:bg-purple-800 transition">
                Register Now
            </button>

            <button class="ml-3 border-2 border-purple-600 text-purple-600 px-6 py-3 rounded-lg hover:bg-purple-600 hover:text-white transition">
                Learn More
            </button>
        </div>

        <p class="mt-6 text-gray-500 text-sm">
            All Students and Faculty Members are Welcome!
        </p>

    </div>

</body>
</html>
